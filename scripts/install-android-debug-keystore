#!/usr/bin/env bash
set -euo pipefail
umask 077

readonly expected_fingerprint="CF:B5:F5:10:2D:C0:75:29:21:A0:0B:6B:6E:43:1F:CA:14:58:59:4B:21:E0:4A:39:CF:27:DC:B7:D4:0C:9D:4F"
readonly key_alias="androiddebugkey"
readonly key_password="android"
readonly onepassword_vault="${GHOSTTY_DEBUG_KEYSTORE_VAULT:-Private}"
readonly onepassword_document="${GHOSTTY_DEBUG_KEYSTORE_DOCUMENT:-Ghostty Mobile Android Debug Keystore}"
readonly destination="${ANDROID_DEBUG_KEYSTORE:-$HOME/.android/debug.keystore}"

replace_existing=false
temporary_file=""
probe_directory=""
lock_directory=""
destination_initially_exists=false
initial_file_identity=""

usage() {
  cat <<EOF
Install Ghostty Mobile's shared Android debug keystore from 1Password.

Usage: $(basename "$0") [--replace]

By default, the script:
  1. Exits successfully if the expected key is already installed.
  2. Downloads the shared key from 1Password when no key exists.
  3. Refuses to overwrite a different key.

Options:
  --replace  Back up and replace a different existing debug keystore.
  --help     Show this help.

Environment overrides:
  ANDROID_DEBUG_KEYSTORE             Destination path.
  GHOSTTY_DEBUG_KEYSTORE_VAULT       1Password vault (default: Private).
  GHOSTTY_DEBUG_KEYSTORE_DOCUMENT    1Password document title.
EOF
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  if [[ $# -gt 1 ]]; then
    printf '\n%s\n' "$2" >&2
  fi
  exit 1
}

cleanup() {
  if [[ -n "$temporary_file" && -f "$temporary_file" ]]; then
    rm -f "$temporary_file"
  fi
  if [[ -n "$probe_directory" && -d "$probe_directory" ]]; then
    rm -f "$probe_directory/probe.p12"
    rmdir "$probe_directory" 2>/dev/null || true
  fi
  if [[ -n "$lock_directory" && -d "$lock_directory" ]]; then
    rmdir "$lock_directory" 2>/dev/null || true
  fi
}
trap cleanup EXIT

while [[ $# -gt 0 ]]; do
  case "$1" in
    --replace)
      replace_existing=true
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      usage >&2
      fail "Unknown option: $1"
      ;;
  esac
  shift
done

if ! command -v keytool >/dev/null 2>&1; then
  fail \
    "Java keytool is not installed or is not on PATH." \
    "Install JDK 17, then rerun this script. keytool is required to verify that Gradle will use the expected signing identity.

On macOS with Homebrew:
  brew install openjdk@17
  export PATH=\"/opt/homebrew/opt/openjdk@17/bin:\$PATH\"

On Intel macOS, replace /opt/homebrew with /usr/local."
fi

keystore_report() {
  LC_ALL=C keytool -list -v \
    -keystore "$1" \
    -storepass "$key_password" \
    -alias "$key_alias" 2>/dev/null
}

fingerprint() {
  local keystore="$1"
  keystore_report "$keystore" | awk -F': ' '/SHA256:/{print $2; exit}'
}

keystore_is_usable() {
  local keystore="$1"
  local report
  local probe
  local status
  report="$(keystore_report "$keystore")" || return 1
  [[ "$report" == *"PrivateKeyEntry"* ]] || return 1

  probe_directory="$(mktemp -d "${TMPDIR:-/tmp}/ghostty-debug-key-probe.XXXXXX")"
  chmod 700 "$probe_directory"
  probe="$probe_directory/probe.p12"
  if keytool -importkeystore -noprompt \
    -srckeystore "$keystore" \
    -srcstorepass "$key_password" \
    -srcalias "$key_alias" \
    -srckeypass "$key_password" \
    -destkeystore "$probe" \
    -deststoretype PKCS12 \
    -deststorepass "$key_password" \
    -destkeypass "$key_password" >/dev/null 2>&1; then
    status=0
  else
    status=1
  fi
  rm -f "$probe"
  rmdir "$probe_directory"
  probe_directory=""
  return "$status"
}

file_identity() {
  cksum "$1" | awk '{print $1 ":" $2}'
}

if [[ -e "$destination" || -L "$destination" ]]; then
  if [[ -L "$destination" || ! -f "$destination" ]]; then
    fail \
      "The debug keystore destination is not a regular file: $destination" \
      "Remove the directory, symlink, or special file manually, then rerun this script. The installer will not follow links or modify non-file destinations because that could overwrite an unintended path."
  fi
  destination_initially_exists=true
  initial_file_identity="$(file_identity "$destination")"
  installed_fingerprint="$(fingerprint "$destination" || true)"
  if [[ "$installed_fingerprint" == "$expected_fingerprint" ]] && keystore_is_usable "$destination"; then
    chmod 600 "$destination"
    printf 'Shared Android debug keystore is already installed at %s.\n' "$destination"
    exit 0
  fi

  if [[ "$replace_existing" != true ]]; then
    fail \
      "A different or unreadable debug keystore already exists at $destination." \
      "Expected SHA-256: $expected_fingerprint
Found SHA-256:    ${installed_fingerprint:-unreadable}

Replacing a debug key prevents new builds from updating apps signed with the old key. Export any app data you need, uninstall dev.ghostty.connect when ready, then rerun with --replace. The existing keystore will be backed up."
  fi
fi

if ! command -v op >/dev/null 2>&1; then
  fail \
    "The 1Password CLI command 'op' is not installed." \
    "Install it from https://developer.1password.com/docs/cli/get-started/ or, on macOS with Homebrew: brew install 1password-cli

The shared keystore is intentionally kept out of this public repository. The installer needs 1Password CLI to retrieve the same signing identity on every development computer."
fi

op_error=""
if ! op_error="$(op vault get "$onepassword_vault" 2>&1)"; then
  fail \
    "1Password CLI cannot access the '$onepassword_vault' vault." \
    "1Password reported:
$op_error

Unlock the 1Password desktop app and enable Settings > Developer > Integrate with 1Password CLI. If the account is not configured, run: op account add. Password-based accounts may require: op signin

CLI authentication is required so the keystore can be downloaded without placing it or an account password in this repository."
fi

if ! op_error="$(op item get "$onepassword_document" --vault "$onepassword_vault" 2>&1)"; then
  fail \
    "The 1Password document '$onepassword_document' was not found in '$onepassword_vault'." \
    "1Password reported:
$op_error

Confirm that this account can access the document. Override its location with GHOSTTY_DEBUG_KEYSTORE_VAULT or GHOSTTY_DEBUG_KEYSTORE_DOCUMENT if your vault uses a different name."
fi

destination_dir="$(dirname "$destination")"
mkdir -p "$destination_dir"
temporary_file="$(mktemp "$destination_dir/.debug.keystore.XXXXXX")"
chmod 600 "$temporary_file"

if ! op document get "$onepassword_document" \
  --vault "$onepassword_vault" \
  --out-file "$temporary_file" \
  --file-mode 0600 \
  --force >/dev/null; then
  fail \
    "1Password could not download the shared debug keystore." \
    "Unlock 1Password, confirm desktop CLI integration is enabled, verify access to the document, and rerun the script."
fi

downloaded_fingerprint="$(fingerprint "$temporary_file" || true)"
if [[ "$downloaded_fingerprint" != "$expected_fingerprint" ]] || ! keystore_is_usable "$temporary_file"; then
  fail \
    "The downloaded document is not the expected Ghostty Mobile debug keystore." \
    "Expected SHA-256: $expected_fingerprint
Found SHA-256:    ${downloaded_fingerprint:-unreadable}

Nothing was installed. Verify the 1Password document before changing the fingerprint recorded in this script."
fi

candidate_lock="$destination.install.lock"
if mkdir "$candidate_lock" 2>/dev/null; then
  lock_directory="$candidate_lock"
else
  fail \
    "Another debug-keystore installation appears to be running for $destination." \
    "Wait for it to finish and rerun this script. If no installer is running, remove the stale lock directory manually: $candidate_lock"
fi

if [[ -e "$destination" || -L "$destination" ]]; then
  if [[ -L "$destination" || ! -f "$destination" ]]; then
    fail "The debug keystore destination became a non-file while the key was downloading: $destination"
  fi
  current_fingerprint="$(fingerprint "$destination" || true)"
  if [[ "$destination_initially_exists" != true ]]; then
    if [[ "$current_fingerprint" == "$expected_fingerprint" ]] && keystore_is_usable "$destination"; then
      chmod 600 "$destination"
      printf 'Shared Android debug keystore was installed by another process at %s.\n' "$destination"
      exit 0
    fi
    fail "A different debug keystore appeared at $destination while the shared key was downloading. Nothing was overwritten."
  fi
  if [[ "$(file_identity "$destination")" != "$initial_file_identity" ]]; then
    fail "The existing debug keystore changed while the shared key was downloading. Nothing was overwritten; rerun the script."
  fi
elif [[ "$destination_initially_exists" == true ]]; then
  fail "The existing debug keystore disappeared while the shared key was downloading. Rerun the script."
fi

backup=""
if [[ -f "$destination" ]]; then
  backup="$(mktemp "$destination.backup.XXXXXXXX")"
  cp -p "$destination" "$backup"
  chmod 600 "$backup"
fi

if [[ "$destination_initially_exists" == true ]]; then
  mv -f "$temporary_file" "$destination"
  temporary_file=""
else
  if ! ln "$temporary_file" "$destination" 2>/dev/null; then
    fail "The debug keystore destination appeared before installation completed. Nothing was overwritten; rerun the script."
  fi
  rm -f "$temporary_file"
  temporary_file=""
fi
chmod 600 "$destination"

installed_fingerprint="$(fingerprint "$destination" || true)"
if [[ "$installed_fingerprint" != "$expected_fingerprint" ]] || ! keystore_is_usable "$destination"; then
  if [[ -n "$backup" ]]; then
    cp -p "$backup" "$destination"
  else
    rm -f "$destination"
  fi
  fail "Installation verification failed for $destination. The previous state was restored."
fi

printf 'Installed the shared Android debug keystore at %s.\n' "$destination"
if [[ -n "$backup" ]]; then
  printf 'Backed up the previous keystore at %s.\n' "$backup"
  printf 'Uninstall dev.ghostty.connect before installing a build signed with the new key.\n'
fi
